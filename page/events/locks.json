{
  "chain": "locks",
  "room": [
    {
      "when": [
        "drawer = open",
        "drawer_third != gobstones"
      ],
      "show": [
        "Percy's drawer standing open on the Fanged Frisbee, the pack of Exploding Snap and a Filibuster firework"
      ]
    },
    {
      "when": [
        "drawer = open",
        "drawer_third = gobstones"
      ],
      "show": [
        "Percy's drawer standing open on the Fanged Frisbee, the pack of Exploding Snap and Percy's Gobstones"
      ]
    },
    {
      "when": [
        "percy_notes >= 1"
      ],
      "show": [
        "Percy's newest note tucked under the drawer's label"
      ]
    },
    {
      "when": [
        "key != held"
      ],
      "show": [
        "the small door's brass lock holding fast against any spell"
      ]
    }
  ],
  "records": [
    {
      "id": "locks.drawer-opens",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "opened percy drawer",
      "when": [
        "drawer != open"
      ],
      "starts": [
        "set drawer = open",
        "set drawer_swap = due",
        "log \"Opened Percy's drawer {day}\"",
        "secret percy-drawer"
      ]
    },
    {
      "id": "locks.drawer-swap-gobstones",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "leave",
      "when": [
        "drawer_swap = due",
        "drawer_third != gobstones"
      ],
      "starts": [
        "set drawer_third = gobstones",
        "set drawer_swap = done"
      ]
    },
    {
      "id": "locks.drawer-swap-firework",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "leave",
      "when": [
        "drawer_swap = due",
        "drawer_third = gobstones"
      ],
      "starts": [
        "set drawer_third = firework",
        "set drawer_swap = done"
      ]
    },
    {
      "id": "locks.relock-1",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "arrive",
      "when": [
        "place = common room",
        "drawer = open",
        "percy_notes = 0"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "percy",
          "at": "drawer",
          "key": "locks.percy-note-1",
          "canon": "ours, in Percy's voice; the twins' things confiscated, as in Filch's drawer (PoA 10, checked)",
          "text": [
            "Someone has been in this drawer. P.W.",
            "This drawer has been opened. It will not happen again. P.W."
          ]
        }
      ],
      "starts": [
        "set drawer = locked",
        "add percy_notes 1"
      ]
    },
    {
      "id": "locks.relock-2",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "arrive",
      "when": [
        "place = common room",
        "drawer = open",
        "percy_notes = 1"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "percy",
          "at": "drawer",
          "key": "locks.percy-note-2",
          "canon": "ours, in Percy's voice",
          "text": [
            "I KNOW someone has been in this drawer. P.W.",
            "I have counted everything in this drawer. TWICE. P.W."
          ]
        }
      ],
      "starts": [
        "set drawer = locked",
        "add percy_notes 1"
      ]
    },
    {
      "id": "locks.relock-3",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "arrive",
      "when": [
        "place = common room",
        "drawer = open",
        "percy_notes = 2"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "percy",
          "at": "drawer",
          "key": "locks.percy-note-3",
          "canon": "ours, in Percy's voice; he calls her Mother (PoA 4, checked)",
          "text": [
            "Fred. George. I am writing to Mother. P.W.",
            "Fred. George. Mother WILL hear of this. P.W."
          ]
        }
      ],
      "starts": [
        "set drawer = locked",
        "add percy_notes 1"
      ]
    },
    {
      "id": "locks.relock-4",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "arrive",
      "when": [
        "place = common room",
        "drawer = open",
        "percy_notes = 3"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "percy",
          "at": "drawer",
          "key": "locks.percy-note-4",
          "canon": "ours, in Percy's voice",
          "text": [
            "Fine.",
            "FINE."
          ]
        }
      ],
      "starts": [
        "set drawer = locked",
        "add percy_notes 1"
      ]
    },
    {
      "id": "locks.relock-fresh",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "arrive",
      "when": [
        "place = common room",
        "drawer = open",
        "percy_notes >= 4"
      ],
      "starts": [
        "set drawer = locked",
        "set percy_notes = 0"
      ]
    },
    {
      "id": "locks.door-list-his",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "tried little door",
      "when": [
        "key != held",
        "door_list != his"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "his",
          "at": "door list",
          "key": "locks.door-list-his",
          "canon": "ours, Magic for the boys, Alohomora in the castle, B6 t1 (Godric, 12 October 2026, 2.56 pm)",
          "text": [
            "Alohomora, {year}. Nothing happened."
          ]
        }
      ],
      "starts": [
        "set door_list = his",
        "log \"Tried Alohomora on the little door {day}. Nothing happened, and he wrote it on the list.\""
      ]
    }
  ]
}
