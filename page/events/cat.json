{
  "chain": "cat",
  "room": [
    {
      "when": [
        "time = night",
        "cat_spot != sofa"
      ],
      "show": [
        "the cat asleep, curled by the hearth"
      ]
    },
    {
      "when": [
        "time = night",
        "cat_spot = sofa"
      ],
      "show": [
        "the cat asleep, curled on the sofa"
      ]
    },
    {
      "when": [
        "time != night",
        "cat_with_him = yes"
      ],
      "show": [
        "the cat sitting at the rug's near edge before the fire, facing it, now and then looking back over her shoulder at him and flicking her tail"
      ]
    }
  ],
  "records": [
    {
      "id": "cat.day-blink",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "tap fire",
      "when": [
        "time != night",
        "book != held",
        "fire != damp",
        "cat by hearth = yes"
      ],
      "show": [
        "the cat sits by the hearth and slow-blinks, content"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.bliss",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat < 2"
      ],
      "show": [
        "the cat rolls over in blissful sleep, paws up, purring"
      ],
      "starts": [
        "add heat 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.warm",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat = 2"
      ],
      "show": [
        "the cat flicks her tail and stretches away from the heat, still asleep"
      ],
      "starts": [
        "add heat 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.wakes",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat >= 3"
      ],
      "show": [
        "the cat wakes, gives him a look, pads to the sofa and curls up again"
      ],
      "starts": [
        "set cat_spot = sofa",
        "log \"Woke the cat with the fire {day}\""
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.twitch",
      "moment": "tap cat",
      "when": [
        "time = night",
        "cat_taps = 0"
      ],
      "show": [
        "one ear twitches"
      ],
      "starts": [
        "add cat_taps 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.stretch",
      "moment": "tap cat",
      "when": [
        "time = night",
        "cat_taps >= 1"
      ],
      "show": [
        "a long sleepy stretch, then curled up again"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.draught-in",
      "moment": "enter",
      "when": [
        "time = night"
      ],
      "show": [
        "the draught ruffles the sleeping cat's fur"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.draught-out",
      "moment": "tap portrait hole",
      "when": [
        "time = night"
      ],
      "show": [
        "the draught ruffles the sleeping cat's fur"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [
        "waiting"
      ],
      "id": "cat.sits-with-him",
      "moment": "quiet 30-60 s",
      "when": [
        "place = common room",
        "time != night",
        "cat_sat != yes"
      ],
      "show": [
        "the cat leaves her loop, walks to the rug's near edge before the fire, clear of the armchair and the round table, sits facing the fire and looks back over her shoulder at him as she settles"
      ],
      "starts": [
        "set cat_sat = yes",
        "set cat_with_him = yes"
      ],
      "ends": [
        {
          "on": "tap any but cat",
          "do": [
            "set cat_with_him = no"
          ]
        },
        {
          "on": "leave",
          "do": [
            "set cat_with_him = no"
          ]
        }
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.looks-again",
      "moment": "tap cat",
      "when": [
        "time != night",
        "cat_with_him = yes"
      ],
      "show": [
        "she looks back at him once more, and stays"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.rejoins",
      "moment": "leave",
      "when": [],
      "starts": [
        "set cat_sat = no"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.settle",
      "moment": "leave",
      "when": [
        "time = night"
      ],
      "starts": [
        "set heat = 0",
        "set cat_taps = 0",
        "set cat_spot = hearth"
      ]
    }
  ]
}
