{
  "chain": "cat",
  "room": [
    {
      "when": [
        "time = night",
        "cat_spot != sofa"
      ],
      "show": [
        "the cat asleep, curled by the hearth"
      ]
    },
    {
      "when": [
        "time = night",
        "cat_spot = sofa"
      ],
      "show": [
        "the cat asleep, curled on the sofa"
      ]
    }
  ],
  "records": [
    {
      "id": "cat.day-blink",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "tap fire",
      "when": [
        "time != night",
        "book != held",
        "fire != damp",
        "cat by hearth = yes"
      ],
      "show": [
        "the cat sits by the hearth and slow-blinks, content"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.bliss",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat < 2"
      ],
      "show": [
        "the cat rolls over in blissful sleep, paws up, purring"
      ],
      "starts": [
        "add heat 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.warm",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat = 2"
      ],
      "show": [
        "the cat flicks her tail and stretches away from the heat, still asleep"
      ],
      "starts": [
        "add heat 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.wakes",
      "moment": "tap fire",
      "when": [
        "time = night",
        "book != held",
        "fire != damp",
        "cat_spot != sofa",
        "heat >= 3"
      ],
      "show": [
        "the cat wakes, gives him a look, pads to the sofa and curls up again"
      ],
      "starts": [
        "set cat_spot = sofa",
        "log \"Woke the cat with the fire {day}\""
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.twitch",
      "moment": "tap cat",
      "when": [
        "time = night",
        "cat_taps = 0"
      ],
      "show": [
        "one ear twitches"
      ],
      "starts": [
        "add cat_taps 1"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.stretch",
      "moment": "tap cat",
      "when": [
        "time = night",
        "cat_taps >= 1"
      ],
      "show": [
        "a long sleepy stretch, then curled up again"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.draught-in",
      "moment": "enter",
      "when": [
        "time = night"
      ],
      "show": [
        "the draught ruffles the sleeping cat's fur"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.draught-out",
      "moment": "tap portrait hole",
      "when": [
        "time = night"
      ],
      "show": [
        "the draught ruffles the sleeping cat's fur"
      ]
    },
    {
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "id": "cat.settle",
      "moment": "leave",
      "when": [
        "time = night"
      ],
      "starts": [
        "set heat = 0",
        "set cat_taps = 0",
        "set cat_spot = hearth"
      ]
    }
  ]
}
