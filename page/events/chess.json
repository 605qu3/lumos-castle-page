{
  "chain": "chess",
  "bags": {
    "famous": [
      {
        "item": "opera",
        "intro": "Paris, 1858. Paul Morphy played this in a box at the opera, and won in seventeen moves."
      },
      {
        "item": "immortal",
        "intro": "London, 1851. Adolf Anderssen gave away both rooks and his queen, and still won. The Immortal Game."
      },
      {
        "item": "evergreen",
        "intro": "Berlin, 1852. Anderssen again. They call this one the Evergreen Game."
      },
      {
        "item": "giant",
        "intro": "Under the trapdoor, on the giant board. A knight gives himself up so a bishop can win."
      }
    ]
  },
  "room": [
    {
      "when": [
        "game != on",
        "game != waiting",
        "game != playing-on",
        "game != showing"
      ],
      "show": [
        "the chess set on the round table, set up and waiting"
      ]
    },
    {
      "when": [
        "game = waiting"
      ],
      "show": [
        "the game on the round table left exactly as it was, his pieces waiting"
      ]
    },
    {
      "when": [
        "game = playing-on"
      ],
      "show": [
        "the pieces on the round table playing on by themselves, quietly"
      ]
    }
  ],
