{
  "chain": "chess",
  "bags": {
    "famous": [
      {
        "item": "opera",
        "intro": "Paris, 1858. Paul Morphy played this in a box at the opera, and won in seventeen moves."
      },
      {
        "item": "immortal",
        "intro": "London, 1851. Adolf Anderssen gave away both rooks and his queen, and still won. The Immortal Game."
      },
      {
        "item": "evergreen",
        "intro": "Berlin, 1852. Anderssen again. They call this one the Evergreen Game."
      },
      {
        "item": "giant",
        "intro": "Under the trapdoor, on the giant board. A knight gives himself up so a bishop can win."
      }
    ]
  },
