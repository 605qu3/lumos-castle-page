{
  "chain": "clementine",
  "room": [
    {
      "when": [
        "letter_open > 0"
      ],
      "show": [
        "her letter on the windowsill"
      ]
    },
    {
      "when": [],
      "show": [
        "the bookshelf, a blue book among the others"
      ]
    },
    {
      "when": [
        "shelf = open"
      ],
      "show": [
        "the bookshelf swung open",
        "her study: a small writing desk and chair",
        "a lamp still burning",
        "a lemon-juice bottle in her hand: 'for secrets'",
        "her photograph",
        "a faded red hair ribbon",
        "a fancy little box"
      ]
    },
    {
      "when": [
        "key = held"
      ],
      "show": [
        "the little box open and empty"
      ]
    }
  ],
  "records": [
    {
      "id": "clementine.letter-1",
      "tier": "big",
      "source": "device",
      "leans": [
        "waiting"
      ],
      "weight": 1,
      "moment": "arrive",
      "when": [
        "letters = 0",
        "today >= next_letter_due",
        "slot = free"
      ],
      "show": [
        "an owl at the window leaves a letter on the sill"
      ],
      "lines": [
        {
          "medium": "written",
          "hand": "clementine",
          "at": "windowsill",
          "key": "clementine.letter-1",
          "text": [
            "To whoever sits by the fire in Gryffindor Tower,\n\nI don't know who you are, or when you are. I only know that when I tuck a letter into the case of my hourglass on a chain, it is gone by morning. I think it goes a very long way.\n\nIs the great fireplace still there, and is it still black with soot right up to the shelf? Ours is. Show the owl.\n\nYours, C.A."
          ]
        }
      ],
      "starts": [
        "set letter_open = 1",
        "take slot",
        "log \"A letter from C.A., 1 of 6, {day}\""
      ],
      "ends": [
        {
          "when": [
            "letter_open = 0"
          ],
          "do": [
            "free slot"
          ]
        },
        {
          "timeout": "7 days",
          "do": [
            "set letter_open = 0",
            "add letters 1",
            "stamp next_letter_due +5-9 days",
            "free slot"
          ],
          "lines": [
            {
              "medium": "written",
              "hand": "clementine",
              "at": "windowsill",
              "key": "clementine.never-mind-1",
              "text": [
                "Never mind. Perhaps you're busy. I'll write again. C.A."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "clementine.answer-1",
      "tier": "fixed",
      "source": "device",
      "leans": [],
      "moment": "tap soot",
      "when": [
        "letter_open = 1"
      ],
      "show": [
        "an owl swoops to the window and takes his answer"
      ],
      "starts": [
        "set letter_open = 0",
        "add letters 1",
        "stamp next_letter_due +5-9 days",
        "log \"Answered C.A.'s letter 1 {day}\""
      ]
    },
